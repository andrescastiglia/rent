# =============================================================================
# Batch Billing System - Crontab Configuration
# =============================================================================
# Historical native deployment example; production uses Kubernetes CronJobs.
# Do not install alongside Kubernetes: this would duplicate executions.
# Adjust paths according to your deployment environment
# =============================================================================

# Environment
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Etc/UTC
TZ=Etc/UTC
BATCH_DIR=/var/www/rent/current/batch
LOG_DIR=/var/log/rent

# -----------------------------------------------------------------------------
# Daily Jobs
# -----------------------------------------------------------------------------

# Billing: Generate invoices for due leases (03:00 AM)
# Suspended pending validation of historical billing data.
# 0 7 * * * cd $BATCH_DIR && node dist/index.js billing --log $LOG_DIR/billing.log

# Overdue: Mark overdue invoices (09:00 AM)
0 8 * * * cd $BATCH_DIR && node dist/index.js overdue --log $LOG_DIR/overdue.log

# Reminders: Send payment reminders via WhatsApp (10:00 AM)
0 9 * * * cd $BATCH_DIR && node dist/index.js reminders --log $LOG_DIR/reminders.log

# Lease renewals: Alert upcoming rental expirations (11:00 AM)
0 11 * * * cd $BATCH_DIR && node dist/index.js lease-renewal-alerts --log $LOG_DIR/lease-renewal-alerts.log

# RAG reconciliation: repair missing/stale projections and verify them (02:30 AM)
30 2 * * * cd $BATCH_DIR && node dist/index.js rag-reconcile --entity all --log $LOG_DIR/rag-reconcile.log

# RAG audit retention: purge expired audit/outbox rows every Sunday (03:30 AM)
15 3 * * 0 cd $BATCH_DIR && node dist/index.js rag-purge-audit --log $LOG_DIR/rag-purge-audit.log

# Exchange rates (daily, 06:30 UTC)
30 6 * * * cd $BATCH_DIR && node dist/index.js sync-rates --log $LOG_DIR/sync-rates.log

# Process WhatsApp webhook inbox (every minute)
* * * * * cd $BATCH_DIR && node dist/index.js process-whatsapp-inbox --log $LOG_DIR/process-whatsapp-inbox.log

# WhatsApp data retention (daily, 04:15 UTC)
15 4 * * * cd $BATCH_DIR && node dist/index.js apply-whatsapp-retention --log $LOG_DIR/apply-whatsapp-retention.log

# -----------------------------------------------------------------------------
# Monthly Jobs
# -----------------------------------------------------------------------------

# Sync Indices: Fetch inflation indices (1st of month, 01:00 AM)
# Suspended; configured daily in Kubernetes, not monthly.
# 0 6 * * * cd $BATCH_DIR && node dist/index.js sync-indices --log $LOG_DIR/sync-indices.log

# Reports: Generate monthly owner reports (1st of month, 06:00 AM)
0 10 1 * * cd $BATCH_DIR && bash scripts/generate-all-reports.sh --log $LOG_DIR/reports.log

# Settlements: Calculate owner settlements (2nd of month, 07:00 AM)
# Retired writer; only --dry-run preview is supported. Keep suspended.
# 0 7 2 * * cd $BATCH_DIR && node dist/index.js process-settlements --log $LOG_DIR/process-settlements.log

# -----------------------------------------------------------------------------
# Maintenance Jobs
# -----------------------------------------------------------------------------

# Log Cleanup: Remove logs older than 30 days (Sunday, 02:00 AM)
0 2 * * 0 find $LOG_DIR -name "*.log" -mtime +30 -delete

# Health Check: Verify batch system is operational (every 6 hours)
0 */6 * * * cd $BATCH_DIR && node dist/index.js --version >> /dev/null 2>&1 || echo "Batch system health check failed" >> $LOG_DIR/alerts.log
