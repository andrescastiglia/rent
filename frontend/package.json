{
  "name": "rent-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:newrelic": "NODE_OPTIONS=\"-r ./newrelic.js -r newrelic\" npm start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:check": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "cross-env NEXT_PUBLIC_MOCK_MODE=true playwright test --project=chromium",
    "test:e2e:cross-browser": "cross-env NEXT_PUBLIC_MOCK_MODE=true playwright test e2e/accessibility-wcag22.spec.ts --project=firefox --project=webkit",
    "test:e2e:ui": "cross-env NEXT_PUBLIC_MOCK_MODE=true playwright test --ui",
    "test:e2e:real": "cross-env NEXT_PUBLIC_MOCK_MODE=false playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-document-load": "^0.67.0",
    "@opentelemetry/instrumentation-fetch": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-web": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.40.0",
    "marked": "^18.0.11",
    "newrelic": "14.3.10",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jiti": "^2.6.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
