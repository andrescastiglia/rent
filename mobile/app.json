{
  "expo": {
    "name": "rent",
    "slug": "rent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.maese.rent",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.maese.rent"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rent",
    "experiments": {
      "typedRoutes": true,
      "onDemandFilesystem": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Rent necesita acceso para mantener la agenda de empresa y sus recordatorios."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rent usa tu ubicaci\u00f3n para calcular la llegada a una visita.",
          "locationAlwaysAndWhenInUsePermission": "Si activ\u00e1s asistencia a visitas, Rent usa tu ubicaci\u00f3n en segundo plano para mostrar contactos cercanos.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "RentProximity",
              "displayName": "Asistencia a visitas",
              "description": "Lugares cercanos y comunicaciones del CRM.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": false,
              "android": null
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "237cd0d5-23f5-49d5-88d7-3c7858833e46"
      }
    },
    "owner": "acastiglia"
  }
}
